# Article Group AI Concierge - Environment Variables
# Copy this file to .env.local and fill in your values

# ===========================================
# SUPABASE
# ===========================================
# Get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===========================================
# ANTHROPIC (Claude)
# ===========================================
# Get this from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-xxxxx

# ===========================================
# OPENAI (for embeddings)
# ===========================================
# Get this from platform.openai.com
# Used for text-embedding-3-small
OPENAI_API_KEY=sk-xxxxx

# ===========================================
# OPENROUTER (optional - one account for everything)
# ===========================================
# When set, embeddings (openai/text-embedding-3-small, same vectors as the
# existing index) and all Claude calls go through OpenRouter, and
# OPENAI_API_KEY / ANTHROPIC_API_KEY are not needed. Get a key at openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-xxxxx

# ===========================================
# LLAMACLOUD API (Document Parsing)
# ===========================================
# Get this from https://cloud.llamaindex.ai
# Pricing: ~$0.003 per page
LLAMA_CLOUD_API_KEY=llx-xxxxx

# ===========================================
# ADMIN API (protect /api/health, /api/analytics)
# ===========================================
# Generate a random token: openssl rand -hex 32
# In production, requests must include: Authorization: Bearer <token>
# In development, these endpoints are open without a token
ADMIN_API_TOKEN=

# ===========================================
# SENTRY (Error Monitoring)
# ===========================================
# Get this from sentry.io after creating a project
# SENTRY_DSN is server-side, NEXT_PUBLIC_SENTRY_DSN is client-side
# SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
# NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
# SENTRY_ORG=your-org
# SENTRY_PROJECT=your-project
# SENTRY_AUTH_TOKEN=sntrys_xxxxx

# ===========================================
# OPTIONAL
# ===========================================
# For development debugging
# DEBUG=true

# ===========================================
# EVAL HARNESS (local only - see eval/README.md)
# ===========================================
# Lets /api/chat honour {"debug": true}: bypasses caches and returns retrieved
# context + raw model output. NEVER set this in production.
# EVAL_DEBUG=true
# EVAL_BASE_URL=http://localhost:3000
# EVAL_DELAY_MS=4000
# EVAL_MODEL=claude-opus-5-5
# EVAL_GRADE_CONCURRENCY=3
